# OpenClaw Docker defaults (non-secret)

# --- API Keys ---
OPENAI_API_KEY=dummy-openai-key
OPENCLAW_GATEWAY_TOKEN=dummy-openclaw-token

# --- LinkedIn Scraper ---
LINKEDIN_USER=your@email.com
LINKEDIN_PASSWORD=yourpassword
LINKEDIN_TARGET_USERNAME=ludekkvapil
LINKEDIN_TARGET_NAME=Ludek Kvapil

# MCP auth uses HTTP Basic where username/password string must match this token value.
OSINT_MCP_TOKEN=change-me

# --- Environment ---
TARGET_ENV=dev

# --- Port Bindings ---
OPENCLAW_PORT=18789
