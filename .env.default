# OpenClaw Docker defaults (non-secret)

# --- API Keys ---
OPENAI_API_KEY=dummy-openai-key
OPENCLAW_GATEWAY_TOKEN=dummy-openclaw-token

# --- Internal MCP gateway ---
# ClawBot's per-agent gateway token: the gateway resolves it to agent id
# `clawbot`. Register the same value with the gateway. Required — compose refuses
# to start without it. MCP_GATEWAY_TOKEN is derived from it in compose.
AGENT_TOKEN_CLAWBOT=dummy-clawbot-agent-token
# Must be https and must resolve to the mcp-tls terminator. See
# clawbot/mcp-tls/gen-certs.sh — the cert's SAN has to match this host.
CLAWBOT_MCP_GATEWAY_URL=https://mcp-gateway.clawbot.internal:8443/mcp/post

# --- Environment ---
TARGET_ENV=dev

# --- Port Bindings ---
OPENCLAW_PORT=18789
HUGO_DEV_PORT=1313

VPS_PASSWORD=PASSWORD
VPS_USER=USER
VPS_HOST=HOST