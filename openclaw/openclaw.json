{
  "models": {
    "providers": {
      "openai": {
        "baseUrl": "https://api.openai.com/v1",
        "apiKey": "${OPENAI_API_KEY}",
        "api": "openai-completions",
        "models": [
          {"id": "gpt-5", "name": "GPT-5"}
        ]
      },
      "dmr": {
        "baseUrl": "${DMR_BASE_URL}",
        "apiKey": "${OLLAMA_API_KEY}",
        "api": "openai-completions",
        "models": [
          {"id": "gpt-oss-vllm", "name": "GPT-OSS vLLM"},
          {"id": "llama3.2", "name": "Llama 3.2"},
          {"id": "mistral", "name": "Mistral"}
        ]
      },
      "ollama": {
        "baseUrl": "${OLLAMA_BASE_URL}",
        "api": "openai-completions",
        "models": [
          {"id": "mistral", "name": "Mistral (Ollama)"},
          {"id": "llama3.2", "name": "Llama 3.2 (Ollama)"},
          {"id": "qwen2.5:7b", "name": "Qwen 2.5 7B (Ollama)"}
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-5",
        "fallbacks": ["ollama/mistral", "dmr/llama3.2", "ollama/qwen2.5:7b"]
      }
    }
  },
  "tools": {
    "allow": []
  },
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:${OPENCLAW_PORT}",
        "http://127.0.0.1:${OPENCLAW_PORT}"
      ]
    },
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "browser": {
    "enabled": true,
    "attachOnly": true,
    "defaultProfile": "remote",
    "profiles": {
      "remote": {
        "cdpUrl": "http://openclaw-sandbox-browser:9222",
        "color": "#FF4500"
      }
    }
  },
  "plugins": {
    "allow": [],
    "load": {
      "paths": []
    },
    "entries": {}
  },
  "mcp": {
    "servers": {
      "site-files": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "/site"]
      },
      "gateway": {
        "url": "http://mcpserver-gateway:8100/mcp/post",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Bearer ${MCP_GATEWAY_TOKEN}"
        }
      },
      "ragchat": {
        "url": "http://ragchat-nginx-1:8080/mcp/post",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Basic ${DRUPAL_MCP_TOKEN}"
        }
      },
      "seobot": {
        "url": "http://seo-crawler-mcp:3001/mcp/post",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Basic ${SEO_MCP_TOKEN_B64}"
        }
      },
      "osintbot": {
        "url": "http://osint-mcp:7861/mcp/post",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Basic ${OSINT_MCP_TOKEN_B64}"
        }
      },
      "sales": {
        "url": "http://sales-assistant-assistant-1:8000/mcp/post",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Basic ${SALES_MCP_TOKEN_B64}"
        }
      }
    }
  }
}
