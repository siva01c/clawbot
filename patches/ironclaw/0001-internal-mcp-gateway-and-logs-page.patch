+/// Extension / product-auth provider id for the internal gateway. Shared with
+/// [`crate::mcp`], which keys its private-target allowance on this exact value.
+pub(crate) const INTERNAL_MCP_GATEWAY_EXTENSION_ID: &str = "mcp-gateway";
+
+const INTERNAL_MCP_GATEWAY_URL_ENV: &str = "CLAWBOT_MCP_GATEWAY_URL";
+const INTERNAL_MCP_GATEWAY_TOKEN_ENV: &str = "MCP_GATEWAY_TOKEN";
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct InternalMcpGatewayEndpoint {
+    pub(crate) url: String,
+    pub(crate) host_pattern: String,
+    pub(crate) port: Option<u16>,
+}
+
+/// Validated URL + bearer token for the internal gateway.
+#[derive(Clone, Debug)]
+pub struct InternalMcpGatewayBootstrapConfig {
+    url: String,
+    token: SecretString,
+    /// The tenant and agent the runtime's turns run under (`[identity]`).
+    /// The credential account must live in that scope, or the runtime
+    /// credential gate never finds it; `None` keeps the local default.
+    runtime_identity: Option<(TenantId, AgentId)>,
+}
+
+impl InternalMcpGatewayBootstrapConfig {
+    pub fn new(
+        url: impl Into<String>,
+        token: SecretString,
+    ) -> Result<Self, InternalMcpGatewayBootstrapConfigError> {
+        let url = url.into().trim().to_string();
+        if url.is_empty() {
+            return Err(InternalMcpGatewayBootstrapConfigError::MissingUrl);
+        }
+        if token.expose_secret().trim().is_empty() {
+            return Err(InternalMcpGatewayBootstrapConfigError::MissingToken);
+        }
+        // Validate eagerly so a malformed URL fails at startup with a clear
+        // reason rather than at first tool call.
+        internal_mcp_gateway_endpoint_from_url(&url)
+            .map_err(InternalMcpGatewayBootstrapConfigError::InvalidUrl)?;
+        Ok(Self {
+            url,
+            token,
+            runtime_identity: None,
+        })
+    }
+
+    /// Builds a config from optionally-present parts. Both absent means the
+    /// operator has not opted in; a URL without a token is a misconfiguration.
+    pub fn from_optional_parts(
+        url: Option<impl Into<String>>,
+        token: Option<SecretString>,
+    ) -> Result<Option<Self>, InternalMcpGatewayBootstrapConfigError> {
+        let url = url
+            .map(Into::into)
+            .map(|value| value.trim().to_string())
+            .filter(|value| !value.is_empty());
+        let token = token.filter(|value| !value.expose_secret().trim().is_empty());
+        match (url, token) {
+            (Some(url), Some(token)) => Self::new(url, token).map(Some),
+            (None, _) => Ok(None),
+            (Some(_), None) => Err(InternalMcpGatewayBootstrapConfigError::MissingToken),
+        }
+    }
+
+    /// Binds the credential to the scope the runtime's turns use.
+    pub fn with_runtime_identity(mut self, tenant_id: TenantId, agent_id: AgentId) -> Self {
+        self.runtime_identity = Some((tenant_id, agent_id));
+        self
+    }
+
+    fn resource_scope(&self, owner_user_id: &UserId) -> Result<ResourceScope, String> {
+        match &self.runtime_identity {
+            // Mirrors the WebUI caller scope (agent set, no project), which is
+            // what the runtime credential gate selects accounts by.
+            Some((tenant_id, agent_id)) => Ok(ResourceScope {
+                tenant_id: tenant_id.clone(),
+                user_id: owner_user_id.clone(),
+                agent_id: Some(agent_id.clone()),
+                project_id: None,
+                mission_id: None,
+                thread_id: None,
+                invocation_id: InvocationId::new(),
+            }),
+            None => ResourceScope::local_default(owner_user_id.clone(), InvocationId::new())
+                .map_err(|error| error.to_string()),
+        }
+    }
+
+    pub(crate) fn endpoint(&self) -> Result<InternalMcpGatewayEndpoint, String> {
+        internal_mcp_gateway_endpoint_from_url(&self.url)
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum InternalMcpGatewayBootstrapConfigError {
+    MissingUrl,
+    MissingToken,
+    InvalidUrl(String),
+}
+
+impl std::fmt::Display for InternalMcpGatewayBootstrapConfigError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::MissingUrl => write!(f, "{INTERNAL_MCP_GATEWAY_URL_ENV} must not be empty"),
+            Self::MissingToken => write!(
+                f,
+                "{INTERNAL_MCP_GATEWAY_TOKEN_ENV} is required when {INTERNAL_MCP_GATEWAY_URL_ENV} is set"
+            ),
+            Self::InvalidUrl(reason) => write!(f, "{reason}"),
+        }
+    }
+}
+
+impl std::error::Error for InternalMcpGatewayBootstrapConfigError {}
+
+pub fn internal_mcp_gateway_bootstrap_config_from_env()
+-> Result<Option<InternalMcpGatewayBootstrapConfig>, InternalMcpGatewayBootstrapConfigError> {
+    let url = ironclaw_common::env_helpers::env_or_override(INTERNAL_MCP_GATEWAY_URL_ENV)
+        .map(|value| value.trim().to_string())
+        .filter(|value| !value.is_empty());
+    let token = ironclaw_common::env_helpers::env_or_override(INTERNAL_MCP_GATEWAY_TOKEN_ENV)
+        .map(|value| value.trim().to_string())
+        .filter(|value| !value.is_empty())
+        .map(SecretString::from);
+    InternalMcpGatewayBootstrapConfig::from_optional_parts(url, token)
+}
+
+/// Parses the operator-supplied gateway URL.
+///
+/// https is mandatory: the hosted-MCP URL check, the discovery check, and the
+/// runtime-credential audience all reject plain http, so a cleartext endpoint
+/// would fail later and less legibly. Unlike the NEAR AI validator the path is
+/// preserved verbatim — the gateway's JSON-RPC entrypoint is `/mcp/post`.
+/// Private and loopback ranges are deliberately accepted; the coarse
+/// link-local / multicast / documentation guard stays.
+pub(crate) fn internal_mcp_gateway_endpoint_from_url(
+    raw: &str,
+) -> Result<InternalMcpGatewayEndpoint, String> {
+    let url = url::Url::parse(raw.trim())
+        .map_err(|error| format!("{INTERNAL_MCP_GATEWAY_URL_ENV} must be an absolute URL: {error}"))?;
+    if url.scheme() != "https" {
+        return Err(format!("{INTERNAL_MCP_GATEWAY_URL_ENV} must use https"));
+    }
+    if !url.username().is_empty() || url.password().is_some() {
+        return Err(format!(
+            "{INTERNAL_MCP_GATEWAY_URL_ENV} must not include userinfo"
+        ));
+    }
+    if url.query().is_some() || url.fragment().is_some() {
+        return Err(format!(
+            "{INTERNAL_MCP_GATEWAY_URL_ENV} must not include query or fragment components"
+        ));
+    }
+
+    let host = url
+        .host_str()
+        .ok_or_else(|| format!("{INTERNAL_MCP_GATEWAY_URL_ENV} must include a host"))?
+        .to_ascii_lowercase();
+    let ip = host.parse::<IpAddr>().ok();
+    if ip.is_some_and(is_forbidden_endpoint_ip) {
+        return Err(format!(
+            "{INTERNAL_MCP_GATEWAY_URL_ENV} host is not allowed"
+        ));
+    }
+    if matches!(ip, Some(IpAddr::V6(_))) {
+        return Err(format!(
+            "{INTERNAL_MCP_GATEWAY_URL_ENV} IPv6 hosts are not supported yet"
+        ));
+    }
+
+    Ok(InternalMcpGatewayEndpoint {
+        url: url.to_string(),
+        host_pattern: host,
+        port: url.port(),
+    })
+}
+
+/// Coarse guard copied from [`crate::nearai_mcp`]. Private and loopback ranges
+/// are intentionally missing: reaching them is the point of this provider.
+fn is_forbidden_endpoint_ip(ip: IpAddr) -> bool {
+    match ip {
+        IpAddr::V4(ip) => {
+            ip.is_link_local()
+                || ip.is_broadcast()
+                || ip.is_documentation()
+                || ip.is_multicast()
+                || ip.octets()[0] == 0
+        }
+        IpAddr::V6(ip) => {
+            ip.is_unspecified()
+                || ip.is_unicast_link_local()
+                || ip.is_multicast()
+                || is_documentation_v6(ip)
+        }
+    }
+}
+
+fn is_documentation_v6(ip: std::net::Ipv6Addr) -> bool {
+    let segments = ip.segments();
+    segments[0] == 0x2001 && segments[1] == 0x0db8
+}
+
+/// Satisfies a boot-time discovery request's obligations before the runtime
+/// egress sees it.
+///
+/// The runtime egress only serves what an obligation handler has staged for
+/// the request's scope and capability: the network policy
+/// (`ApplyNetworkPolicy`) and the gateway token (`InjectCredentialAccountOnce`).
+/// Tool calls get both from the dispatcher; boot-time discovery has no
+/// dispatcher, so without this every discovery request fails, first as
+/// `network_policy_missing`, then as `credential_unavailable`.
+struct ObligationStagingEgress {
+    inner: Arc<dyn RuntimeHttpEgress>,
+    obligations: Arc<dyn CapabilityObligationHandler>,
+}
+
+#[async_trait]
+impl RuntimeHttpEgress for ObligationStagingEgress {
+    async fn execute(
+        &self,
+        request: RuntimeHttpEgressRequest,
+    ) -> Result<RuntimeHttpEgressResponse, RuntimeHttpEgressError> {
+        let denied = |reason: &str| RuntimeHttpEgressError::Request {
+            reason: format!("internal MCP gateway discovery: {reason}"),
+            request_bytes: 0,
+            response_bytes: 0,
+        };
+        let extension_id = ExtensionId::new(INTERNAL_MCP_GATEWAY_EXTENSION_ID)
+            .map_err(|_| denied("invalid extension id"))?;
+        let provider = RuntimeCredentialAccountProviderId::new(INTERNAL_MCP_GATEWAY_EXTENSION_ID)
+            .map_err(|_| denied("invalid provider id"))?;
+
+        let mut obligations = vec![Obligation::ApplyNetworkPolicy {
+            policy: request.network_policy.clone(),
+        }];
+        for injection in &request.credential_injections {
+            if matches!(injection.source, RuntimeCredentialSource::StagedObligation { .. }) {
+                obligations.push(Obligation::InjectCredentialAccountOnce {
+                    handle: injection.handle.clone(),
+                    provider: provider.clone(),
+                    setup: RuntimeCredentialAccountSetup::default(),
+                    provider_scopes: Vec::new(),
+                    requester_extension: extension_id.clone(),
+                });
+            }
+        }
+
+        let resource_scope = request.scope.clone();
+        let context = ExecutionContext {
+            invocation_id: resource_scope.invocation_id,
+            correlation_id: CorrelationId::new(),
+            process_id: None,
+            parent_process_id: None,
+            tenant_id: resource_scope.tenant_id.clone(),
+            user_id: resource_scope.user_id.clone(),
+            agent_id: resource_scope.agent_id.clone(),
+            project_id: resource_scope.project_id.clone(),
+            mission_id: resource_scope.mission_id.clone(),
+            thread_id: resource_scope.thread_id.clone(),
+            extension_id,
+            runtime: request.runtime,
+            trust: TrustClass::System,
+            grants: CapabilitySet::default(),
+            mounts: MountView::default(),
+            resource_scope,
+        };
+        context
+            .validate()
+            .map_err(|_| denied("invalid execution context"))?;
+        let estimate = ResourceEstimate {
+            network_egress_bytes: request.network_policy.max_egress_bytes,
+            ..ResourceEstimate::default()
+        };
+        self.obligations
+            .satisfy(CapabilityObligationRequest {
+                phase: CapabilityObligationPhase::Invoke,
+                context: &context,
+                capability_id: &request.capability_id,
+                estimate: &estimate,
+                obligations: &obligations,
+            })
+            .await
+            .map_err(|error| {
+                tracing::debug!(%error, "internal MCP gateway discovery obligations failed");
+                denied("obligations were not satisfied")
+            })?;
+        self.inner.execute(request).await
+    }
+}
+
+/// Installs, credentials, and activates the internal gateway extension on boot.
+///
+/// Activation runs [`ExtensionActivationMode::HostedMcpDiscovery`] so the
+/// aggregated backends' tools are published immediately. A gateway that is down
+/// yields a transient discovery failure, which the lifecycle service downgrades
+/// to "keep the bundled manifest" — boot still succeeds and re-activating from
+/// the extensions UI retries discovery.
+pub(crate) async fn bootstrap_local_dev_internal_mcp_gateway(
+    config: Option<InternalMcpGatewayBootstrapConfig>,
+    product_auth: &Arc<RebornProductAuthServices>,
+    extension_management: &Arc<RebornLocalExtensionManagementPort>,
+    runtime_http_egress: Arc<dyn RuntimeHttpEgress>,
+    obligation_handler: Arc<dyn CapabilityObligationHandler>,
+    owner_user_id: &UserId,
+) -> Result<(), RebornBuildError> {
+    let Some(config) = config else {
+        return Ok(());
+    };
+    let runtime_http_egress: Arc<dyn RuntimeHttpEgress> = Arc::new(ObligationStagingEgress {
+        inner: runtime_http_egress,
+        obligations: obligation_handler,
+    });
+    config
+        .endpoint()
+        .map_err(|error| RebornBuildError::InvalidConfig {
+            reason: format!(
+                "internal MCP gateway auto-enable skipped: invalid {INTERNAL_MCP_GATEWAY_URL_ENV}: {error}"
+            ),
+        })?;
+
+    let package_ref = LifecyclePackageRef::new(
+        LifecyclePackageKind::Extension,
+        INTERNAL_MCP_GATEWAY_EXTENSION_ID,
+    )
+    .map_err(|error| RebornBuildError::InvalidConfig {
+        reason: format!("internal MCP gateway package ref is invalid: {error}"),
+    })?;
+    let phase = extension_management
+        .project(package_ref.clone())
+        .await
+        .map_err(|error| RebornBuildError::InvalidConfig {
+            reason: format!("internal MCP gateway extension projection failed: {error}"),
+        })?
+        .phase;
+    match phase {
+        LifecyclePhase::Discovered | LifecyclePhase::Installed | LifecyclePhase::Active => {}
+        LifecyclePhase::Disabled => {
+            tracing::debug!(
+                "internal MCP gateway credentials are present, but the extension is disabled; preserving explicit disabled state"
+            );
+            return Ok(());
+        }
+        other => {
+            tracing::warn!(
+                phase = ?other,
+                "internal MCP gateway credentials are present, but the extension is not in an auto-activatable phase"
+            );
+            return Ok(());
+        }
+    }
+
+    let resource_scope =
+        config
+            .resource_scope(owner_user_id)
+            .map_err(|error| RebornBuildError::InvalidConfig {
+                reason: format!(
+                    "internal MCP gateway auto-enable scope could not be built: {error}"
+                ),
+            })?;
+    let scope = AuthProductScope::new(resource_scope.clone(), AuthSurface::Api);
+    let provider = AuthProviderId::new(INTERNAL_MCP_GATEWAY_EXTENSION_ID).map_err(|error| {
+        RebornBuildError::InvalidConfig {
+            reason: format!("internal MCP gateway provider id is invalid: {error}"),
+        }
+    })?;
+    let existing_account = product_auth
+        .credential_account_record_source()
+        .accounts_for_owner(&scope)
+        .await
+        .map_err(|error| RebornBuildError::InvalidConfig {
+            reason: format!("internal MCP gateway product-auth lookup failed: {error}"),
+        })?
+        .into_iter()
+        .filter(|account| account.provider == provider)
+        .max_by_key(|account| (account.updated_at, account.created_at, account.id));
+    // An update must name the account's own scope exactly: scope equality
+    // includes the invocation id, and a fresh one is minted every boot, so
+    // updating under the new scope was refused as cross-scope and the
+    // bootstrap stopped before discovery on every restart.
+    let submit_scope = existing_account
+        .as_ref()
+        .map(|account| account.scope.clone())
+        .unwrap_or(scope);
+    let existing_account = existing_account.map(|account| CredentialAccountUpdateBinding {
+        account_id: account.id,
+        ownership: account.ownership,
+        owner_extension: account.owner_extension.clone(),
+        granted_extensions: account.granted_extensions.clone(),
+    });
+
+    let credential_submit = ProductAuthExtensionCredentialSetup::new(Arc::clone(product_auth))
+        .submit_manual_token(ExtensionCredentialSubmitRequest {
+            scope: submit_scope,
+            provider,
+            label: "Internal MCP gateway token".to_string(),
+            requester_extension: ExtensionId::new(INTERNAL_MCP_GATEWAY_EXTENSION_ID).map_err(
+                |error| RebornBuildError::InvalidConfig {
+                    reason: format!(
+                        "internal MCP gateway requester extension id is invalid: {error}"
+                    ),
+                },
+            )?,
+            existing_account,
+            secret: config.token,
+        })
+        .await;
+    if let Err(error) = credential_submit {
+        if is_internal_mcp_gateway_disabled_or_removed(&error) {
+            tracing::debug!(
+                "internal MCP gateway credentials are present, but the extension participant is disabled or removed; preserving explicit operator state"
+            );
+            return Ok(());
+        }
+        return Err(RebornBuildError::InvalidConfig {
+            reason: format!("internal MCP gateway product-auth credential submit failed: {error:?}"),
+        });
+    }
+
+    if phase == LifecyclePhase::Discovered {
+        extension_management
+            .install(package_ref.clone())
+            .await
+            .map_err(|error| RebornBuildError::InvalidConfig {
+                reason: format!("internal MCP gateway extension install failed: {error}"),
+            })?;
+    }
+    if !matches!(
+        phase,
+        LifecyclePhase::Discovered | LifecyclePhase::Installed | LifecyclePhase::Active
+    ) {
+        return Ok(());
+    }
+    let activation = extension_management
+        .activate_with_credential_gate(
+            package_ref,
+            ExtensionActivationMode::HostedMcpDiscovery {
+                scope: resource_scope.clone(),
+                runtime_http_egress,
+            },
+            RuntimeExtensionActivationCredentialGate::new(
+                resource_scope,
+                product_auth.runtime_credential_account_selection_service(),
+            ),
+        )
+        .await;
+    match activation {
+        Ok(_) => Ok(()),
+        // Discovered tools live in memory only, so an extension that was
+        // already active is re-activated to re-run discovery after a restart.
+        // That re-run is best effort: failing it must not stop the boot.
+        Err(error) if phase == LifecyclePhase::Active => {
+            tracing::warn!(%error, "internal MCP gateway re-discovery after restart failed");
+            Ok(())
+        }
+        Err(error) => Err(RebornBuildError::InvalidConfig {
+            reason: format!("internal MCP gateway extension activation failed: {error}"),
+        }),
+    }
+}
+
+fn is_internal_mcp_gateway_disabled_or_removed(error: &RebornServicesError) -> bool {
+    error.code == RebornServicesErrorCode::Forbidden
+        && error.kind == RebornServicesErrorKind::ParticipantDenied
+}
