+/// Replaces a description the model-safety check rejects with a neutral one.
+///
+/// Descriptions of discovered MCP tools are third-party text: one docstring
+/// naming an endpoint path or the words "API key" used to fail the whole
+/// prompt, and with it every turn the agent took. The rejected text still
+/// never reaches the model; only the failure is contained to that one tool.
+/// Names stay strict: an unsafe name is still fatal below.
+fn neutralize_unsafe_description(descriptor: &mut CapabilityDescriptorView) {
+    if validate_model_safe_text(descriptor.safe_description.clone(), "capability safe description")
+        .is_ok()
+    {
+        return;
+    }
+    tracing::warn!(
+        capability = %descriptor.capability_id.as_str(),
+        "capability description is not model-safe; replaced with a neutral one"
+    );
+    descriptor.safe_description = format!("Capability {}.", descriptor.safe_name);
