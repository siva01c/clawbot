+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    struct InternalMcpGatewayEnvGuard {
+        _lock: std::sync::MutexGuard<'static, ()>,
+    }
+
+    impl InternalMcpGatewayEnvGuard {
+        fn new() -> Self {
+            let lock = ironclaw_common::env_helpers::lock_env();
+            assert!(
+                std::env::var_os(INTERNAL_MCP_GATEWAY_URL_ENV).is_none(),
+                "{INTERNAL_MCP_GATEWAY_URL_ENV} must be unset for deterministic env tests"
+            );
+            assert!(
+                std::env::var_os(INTERNAL_MCP_GATEWAY_TOKEN_ENV).is_none(),
+                "{INTERNAL_MCP_GATEWAY_TOKEN_ENV} must be unset for deterministic env tests"
+            );
+            ironclaw_common::env_helpers::remove_runtime_env(INTERNAL_MCP_GATEWAY_URL_ENV);
+            ironclaw_common::env_helpers::remove_runtime_env(INTERNAL_MCP_GATEWAY_TOKEN_ENV);
+            Self { _lock: lock }
+        }
+
+        fn set_url(&self, value: &str) {
+            ironclaw_common::env_helpers::set_runtime_env(INTERNAL_MCP_GATEWAY_URL_ENV, value);
+        }
+
+        fn set_token(&self, value: &str) {
+            ironclaw_common::env_helpers::set_runtime_env(INTERNAL_MCP_GATEWAY_TOKEN_ENV, value);
+        }
+    }
+
+    impl Drop for InternalMcpGatewayEnvGuard {
+        fn drop(&mut self) {
+            ironclaw_common::env_helpers::remove_runtime_env(INTERNAL_MCP_GATEWAY_URL_ENV);
+            ironclaw_common::env_helpers::remove_runtime_env(INTERNAL_MCP_GATEWAY_TOKEN_ENV);
+        }
+    }
+
+    #[test]
+    fn endpoint_preserves_gateway_path_and_port() {
+        let endpoint = internal_mcp_gateway_endpoint_from_url(
+            "https://mcp-gateway.clawbot.internal:8443/mcp/post",
+        )
+        .expect("gateway endpoint");
+
+        assert_eq!(
+            endpoint.url,
+            "https://mcp-gateway.clawbot.internal:8443/mcp/post"
+        );
+        assert_eq!(endpoint.host_pattern, "mcp-gateway.clawbot.internal");
+        assert_eq!(endpoint.port, Some(8443));
+    }
+
+    #[test]
+    fn endpoint_allows_private_and_loopback_hosts() {
+        // The whole point of this provider: the NEAR AI validator's public-only
+        // stance is deliberately not inherited.
+        let private = internal_mcp_gateway_endpoint_from_url("https://172.18.0.7:8443/mcp/post")
+            .expect("private IP");
+        let loopback = internal_mcp_gateway_endpoint_from_url("https://127.0.0.1:8443/mcp/post")
+            .expect("loopback IP");
+
+        assert_eq!(private.host_pattern, "172.18.0.7");
+        assert_eq!(loopback.port, Some(8443));
+    }
+
+    #[test]
+    fn endpoint_rejects_http_userinfo_query_and_fragment() {
+        assert!(internal_mcp_gateway_endpoint_from_url("http://gateway.internal/mcp/post").is_err());
+        assert!(
+            internal_mcp_gateway_endpoint_from_url("https://user@gateway.internal/mcp/post")
+                .is_err()
+        );
+        assert!(
+            internal_mcp_gateway_endpoint_from_url("https://gateway.internal/mcp/post?a=1").is_err()
+        );
+        assert!(
+            internal_mcp_gateway_endpoint_from_url("https://gateway.internal/mcp/post#frag")
+                .is_err()
+        );
+        assert!(internal_mcp_gateway_endpoint_from_url("not-a-url").is_err());
+    }
+
+    #[test]
+    fn endpoint_rejects_link_local_and_multicast_hosts() {
+        assert!(internal_mcp_gateway_endpoint_from_url("https://169.254.169.254/mcp/post").is_err());
+        assert!(internal_mcp_gateway_endpoint_from_url("https://224.0.0.1/mcp/post").is_err());
+    }
+
+    #[test]
+    fn config_requires_token_when_url_is_set() {
+        assert_eq!(
+            InternalMcpGatewayBootstrapConfig::from_optional_parts(
+                Some("https://gateway.internal/mcp/post"),
+                None
+            )
