@@ -0,0 +1,35 @@
+schema_version = "reborn.extension_manifest.v2"
+id = "mcp-gateway"
+name = "MCP Gateway"
+version = "0.1.0"
+description = "Aggregated in-house MCP servers (SEO, sales, OSINT, RAG/CMS, observability) behind one gateway."
+trust = "first_party_requested"
+
+# `url` is a placeholder: composition rewrites it from CLAWBOT_MCP_GATEWAY_URL
+# before the package enters the catalog. The extension is only registered when
+# that variable is set, so this value is never dialled.
+[runtime]
+kind = "mcp"
+transport = "http"
+url = "https://mcp-gateway.invalid/mcp/post"
+
+# Single template capability. On activation the runtime replaces the whole
+# capability list with what the gateway returns from `tools/list`, copying this
+# entry's effects/credentials/host-ports onto every discovered tool — see
+# `package_with_discovered_hosted_mcp_tools`. `visibility = "api"` keeps this
+# placeholder out of the model's tool surface when discovery fails and the
+# bundled manifest stays in place; discovered tools are published as `model`
+# regardless.
+[[capabilities]]
+id = "mcp-gateway.tools"
+description = "Template for tools discovered from the aggregated MCP gateway."
+effects = ["dispatch_capability", "network", "use_secret", "external_write"]
+runtime_credentials = [
+  { handle = "mcp_gateway_token", source = { type = "product_auth_account", provider = "mcp-gateway" }, audience = { scheme = "https", host_pattern = "mcp-gateway.invalid" }, target = { type = "header", name = "authorization", prefix = "Bearer " } },
+]
+default_permission = "ask"
+visibility = "api"
+input_schema_ref = "schemas/mcp-gateway/tools.input.v1.json"
+output_schema_ref = "schemas/mcp-gateway/tools.output.v1.json"
+prompt_doc_ref = "prompts/mcp-gateway/tools.md"
+required_host_ports = ["host.runtime.http_egress"]
