+/// Rewrites the bundled placeholder manifest with the operator-configured
+/// endpoint. Mirrors [`nearai_mcp_manifest_toml_for_endpoint`]: the runtime URL
+/// and the runtime-credential audience must agree, or the egress planner drops
+/// the bearer injection and the gateway answers 401.
+fn internal_mcp_gateway_manifest_toml_for_endpoint(
+    endpoint: &InternalMcpGatewayEndpoint,
+) -> Result<String, ProductWorkflowError> {
+    let mut manifest = toml::from_str::<Value>(INTERNAL_MCP_GATEWAY_MANIFEST).map_err(|error| {
+        map_binding_error(format!(
+            "bundled MCP gateway manifest TOML is invalid: {error}"
+        ))
+    })?;
+    let runtime = manifest
+        .get_mut("runtime")
+        .and_then(Value::as_table_mut)
+        .ok_or_else(|| map_binding_error("bundled MCP gateway manifest lacks runtime table"))?;
+    runtime.insert("url".to_string(), Value::String(endpoint.url.clone()));
+
+    let capabilities = manifest
+        .get_mut("capabilities")
+        .and_then(Value::as_array_mut)
+        .ok_or_else(|| {
+            map_binding_error("bundled MCP gateway manifest lacks capabilities array")
+        })?;
+    let template = capabilities
+        .first_mut()
+        .and_then(Value::as_table_mut)
+        .ok_or_else(|| {
+            map_binding_error("bundled MCP gateway manifest lacks capability template")
+        })?;
+    let runtime_credentials = template
+        .get_mut("runtime_credentials")
+        .and_then(Value::as_array_mut)
+        .ok_or_else(|| {
+            map_binding_error("bundled MCP gateway manifest lacks runtime credentials")
+        })?;
+    let credential = runtime_credentials
+        .first_mut()
+        .and_then(Value::as_table_mut)
+        .ok_or_else(|| {
+            map_binding_error("bundled MCP gateway manifest lacks runtime credential")
+        })?;
+    let audience = credential
+        .get_mut("audience")
+        .and_then(Value::as_table_mut)
+        .ok_or_else(|| {
+            map_binding_error("bundled MCP gateway manifest lacks runtime credential audience")
+        })?;
+    audience.insert(
+        "host_pattern".to_string(),
+        Value::String(endpoint.host_pattern.clone()),
+    );
+    if let Some(port) = endpoint.port {
+        audience.insert("port".to_string(), Value::Integer(i64::from(port)));
+    } else {
+        audience.remove("port");
+    }
+
+    toml::to_string(&manifest).map_err(|error| {
+        map_binding_error(format!(
+            "bundled MCP gateway manifest TOML render failed: {error}"
+        ))
+    })
+}
